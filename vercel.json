{
  "rewrites": [
    { "source": "/guia", "destination": "/guia/index.html" },
    { "source": "/solarsemlimites", "destination": "/solarsemlimites/index.html" },
    { "source": "/solarsemlimites/", "destination": "/solarsemlimites/index.html" }
  ],
  "headers": [
    {
      "source": "/guia/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
